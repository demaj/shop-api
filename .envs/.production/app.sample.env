# Application secrets for the `web` service (copy to app.secrets.env, fill in).
SECRET_KEY=<openssl rand -hex 32>

FIRST_SUPERUSER=<admin-email>
FIRST_SUPERUSER_PASSWORD=<at-least-8-characters>

# Must use the async driver prefix and match the db.secrets.env credentials.
DATABASE_URI=postgresql+asyncpg://<db-user>:<db-password>@db:5432/<db-name>
